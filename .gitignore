node_modules/
.DS_Store
dist/
missions/*/
# Déclarations locales des projets : le gabarit est versionné, la déclaration
# du poste ne l'est pas.
missions/projects.yml
# Playbooks du workspace : ils portent des règles propres à un projet ou à une
# entreprise, donc ils restent locaux. Le panneau les lit sur le poste.
/playbook/
# Configuration personnelle du poste (dotfiles Emacs/Ghostty, manifeste de
# liens, empreinte GPG) : elle se recrée localement, voir le README.
/config/
# Workflows rangés hors du dépôt : le dossier suit `workflows/model/`, ses
# fichiers ne partent pas avec le clone.
workflows/local/

# Configuration Emacs propre au poste (MIS-135) : le gabarit et le script
# sont versionnés, le fichier du système et sa liste générée ne le sont pas.
config/tools/emacs/system.yml
config/tools/emacs/system-plugins.el

# Brouillons et caches de travail locaux.
/.tmp/
