# Ghostty — réglages propres à macOS.
#
# Ce fichier est celui que config/links-home.yml lie à
# ~/Library/Application Support/com.mitchellh.ghostty/config sur macOS. Le socle
# commun (thème, police, fenêtre, intégration shell, raccourcis h/j/k/l) vit
# dans `config`, inclus ci-dessous. Ghostty n'a pas de syntaxe conditionnelle :
# le choix Linux/macOS se fait par le lien, pas par ce fichier.
#
# L'inclusion est écrite en absolu (~, étendu par Ghostty) : une relative
# dépendrait de la façon dont Ghostty résout le lien symbolique, et une
# inclusion introuvable ne produit aucune erreur. L'absolu ne laisse pas place
# au doute ; en contrepartie, il fixe l'emplacement du dépôt à ~/projects/missions.

config-file = ~/projects/missions/config/tools/ghostty/config

# Option macOS seule (l'Option sert de Meta pour les raccourcis Emacs).
macos-option-as-alt = left

# --- Flèches : macOS seul ---
# Sous KDE ces liaisons sont interceptées par KWin (Super+Shift+←/→ = fenêtre
# vers l'écran voisin, Super+Ctrl+flèches = changements de bureau virtuel),
# donc elles ne sont pas dans le socle.
keybind = cmd+shift+left=goto_split:left
keybind = cmd+shift+right=goto_split:right
keybind = cmd+shift+up=goto_split:up
keybind = cmd+shift+down=goto_split:down

keybind = cmd+ctrl+right=resize_split:right,20
keybind = cmd+ctrl+left=resize_split:left,20
keybind = cmd+ctrl+up=resize_split:up,20
keybind = cmd+ctrl+down=resize_split:down,20
