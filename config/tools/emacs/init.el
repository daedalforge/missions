;;; init.el --- Emacs configuration for this system -*- lexical-binding: t; -*-

;;; Modules live next to this file, in the missions repository.
;;; `~/.emacs.d/init.el` is a symlink: resolve it so `load-path` names the
;;; real directory, not the link.
(defconst emacs-config-directory
  (file-name-directory (file-truename (or load-file-name buffer-file-name)))
  "Répertoire de cette configuration.")

(add-to-list 'load-path emacs-config-directory)

;;; The nine modules, in their historical order.  `system-plugins.el`,
;;; generated by setup.mjs, says which of them this system loads.
(defconst emacs-plugins-all
  '(init-ui init-editing init-crypto init-markdown init-latex
    init-completion init-projectile init-magit init-machete)
  "Les neuf modules de la configuration.")

(defvar emacs-plugins nil
  "Modules à charger, décidés par system-plugins.el.")

;;; State directories, kept out of the repository.
(dolist (dir '("backups" "auto-save"))
  (make-directory (expand-file-name dir user-emacs-directory) t))

;;; The generated list.  Without it (a fresh clone), load all nine modules so
;;; Emacs still starts; the warning says how to decide.
(let ((generated (expand-file-name "system-plugins.el" emacs-config-directory)))
  (if (file-exists-p generated)
      (load generated nil t)
    (message "init: %s absent, chargement des neuf modules (lancer setup.mjs)"
             generated)
    (setq emacs-plugins emacs-plugins-all)))

(defun emacs-config--failure-message (err)
  "Traduire ERR en une phrase courte, avec le nom du fichier manquant."
  (let ((text (error-message-string err)))
    (if (string-match "Cannot open load file[^,]*,[ \t]*\\([^ \t\n]+\\)" text)
        (format "%s introuvable" (match-string 1 text))
      text)))

;;; Load one module at a time.  A module that fails warns and lets the others
;;; load: a package missing on this system must not abort startup.
(defvar emacs-plugin-status nil
  "Alist (module . état), dans l'ordre canonique.")

(dolist (module emacs-plugins-all)
  (cond
   ((not (memq module emacs-plugins))
    (push (cons module "non chargé (désactivé)") emacs-plugin-status))
   (t
    (condition-case err
        (progn
          (require module)
          (push (cons module "chargé") emacs-plugin-status))
      (error
       (push (cons module (emacs-config--failure-message err))
             emacs-plugin-status))))))

(setq emacs-plugin-status (nreverse emacs-plugin-status))

;;; Custom settings
(when (file-exists-p custom-file)
  (load custom-file nil t))

;;; Restore a normal GC threshold after startup.
(add-hook 'emacs-startup-hook
          (lambda () (setq gc-cons-threshold (* 32 1024 1024))))

(provide 'init)
;;; init.el ends here
