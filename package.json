{
  "name": "@daedalforge/dsh-missions",
  "version": "0.1.15",
  "private": true,
  "description": "Missions panel for the DSH sidebar: reads the trackers declared in missions/projects.yml",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "missions/projects.yml",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "scripts": {
    "test": "node --test test/",
    "build": "node tools/build.mjs"
  }
}
